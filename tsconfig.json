{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/cli/**/*.ts",
    "src/engine/**/*.ts",
    "src/harnesses/**/*.ts",
    "src/output/**/*.ts",
    "src/server/**/*.ts",
    "src/bundler/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "src/viewer/**", "src/specify_cli/**"]
}
